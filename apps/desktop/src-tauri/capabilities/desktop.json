{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Allows the loopback-hosted main WebView to participate in the desktop close handshake and Session log archive operations.",
  "local": false,
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-desktop-ready",
    "allow-desktop-resolve-close",
    "allow-desktop-pick-folder",
    "allow-desktop-save-session-log",
    "allow-desktop-reveal-session-log",
    "allow-desktop-open-session-log"
  ]
}
