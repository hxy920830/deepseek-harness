{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.1.0-rc.5",
  "identifier": "ai.deepseek.harness",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm run prepare-dev",
      "wait": true
    },
    "beforeBuildCommand": "pnpm run stage-runtime",
    "frontendDist": "../bootstrap"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["desktop"],
      "csp": "default-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "runtime"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
